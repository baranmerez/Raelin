{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!dist", "!src-tauri/target", "!src-tauri/gen", "!node_modules"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noDescendingSpecificity": "off" }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double" }
  }
}
